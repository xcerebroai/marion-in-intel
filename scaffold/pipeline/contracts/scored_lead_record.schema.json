{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcerebro.framework/v5.5.0/contracts/scored_lead_record.schema.json",
  "title": "Processed lead record (v5.5.0 — scoring removed, is_new tracking added)",
  "description": "A processed lead wraps a matched_lead with classification, enrichment, review output, and new-lead tracking. Scoring has been removed — clients build their own ranking on top of signal data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scored_lead_id",
    "lead_id",
    "primary_parcel_id",
    "owner_name",
    "owner_type",
    "deal_paths",
    "pattern_set",
    "patterns",
    "display_patterns",
    "stack_depth",
    "attributes",
    "review_flags",
    "lead_status",
    "enrichment_status",
    "evidence_ids",
    "source_ids"
  ],
  "properties": {
    "scored_lead_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique id for the processed lead. Deterministic given the same matched_lead + same enrichment inputs."
    },
    "lead_id": {
      "type": "string",
      "minLength": 1,
      "description": "Back-reference to the matched_lead this lead is derived from."
    },
    "primary_parcel_id": {
      "type": ["string", "null"],
      "description": "Carried from the matched_lead. null when parcel_resolution_status is UNRESOLVED / REVIEW_REQUIRED."
    },
    "owner_name": {
      "type": "string",
      "minLength": 1,
      "description": "Carried from the matched_lead."
    },
    "owner_type": {
      "type": "string",
      "enum": ["ENTITY", "ESTATE", "TRUST", "INDIVIDUAL", "UNKNOWN"],
      "description": "Carried from the matched_lead."
    },
    "deal_paths": {
      "type": "array",
      "description": "Deal-path classifications per domain/04_deal_path_classifier.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "confidence", "rationale"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["high", "moderate", "low"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pattern_set": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Distinct stack-contributing patterns."
    },
    "patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Ordered stack-contributing patterns (with duplicates)."
    },
    "display_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Patterns for the dashboard chips."
    },
    "stack_depth": {
      "type": "integer",
      "minimum": 0,
      "description": "len(patterns). Number of stacked signals."
    },
    "attributes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Parcel attributes — derived from enrichment when present, empty when not."
    },
    "review_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Review-queue flags per review.evaluate_review_queue."
    },
    "lead_status": {
      "type": "string",
      "enum": [
        "STACKED_LEAD",
        "REVIEW_REQUIRED",
        "APPROVED_FOR_DASHBOARD"
      ],
      "description": "Lifecycle status post-processing + review evaluation."
    },
    "enrichment_status": {
      "type": "string",
      "enum": ["ENRICHED", "UNENRICHED"],
      "description": "ENRICHED when parcel-master data was attached; UNENRICHED when processing ran on distress signals alone."
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Union of all evidence ledger entry ids across the matched_lead's signals."
    },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Distinct source_ids contributing to this lead."
    },
    "source_urls": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Distinct source_urls (deep links to the originating records)."
    },
    "primary_event_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Most recent event date across matched_lead.signals."
    },
    "match_confidence": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Parcel-master match confidence. Null when matcher metadata is not available."
    },
    "doc_type_normalization": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Doc-type bridge metadata. Audit field.",
      "properties": {
        "canonical_doc_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "normalized_doc_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "doc_type_review_required": { "type": "boolean" }
      }
    },
    "parcel_display": {
      "type": ["object", "null"],
      "description": "OPTIONAL parcel-master snapshot used by the dashboard. Present iff enrichment_status is ENRICHED.",
      "additionalProperties": false,
      "properties": {
        "situs_address": { "type": ["string", "null"] },
        "situs_city": { "type": ["string", "null"] },
        "situs_state": { "type": ["string", "null"] },
        "owner_mailing_address": { "type": ["string", "null"] },
        "owner_mailing_city": { "type": ["string", "null"] },
        "owner_mailing_state": { "type": ["string", "null"] },
        "owner_mailing_zip": { "type": ["string", "null"] },
        "assessed_value": { "type": ["number", "null"] },
        "last_sale_price": { "type": ["number", "null"] },
        "last_sale_date": { "type": ["string", "null"], "format": "date" },
        "year_built": { "type": ["integer", "null"] },
        "property_class": { "type": ["string", "null"] }
      }
    },
    "lead_status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "transitioned_at", "reason"],
        "properties": {
          "status": { "type": "string", "minLength": 1 },
          "transitioned_at": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "is_new": {
      "type": "boolean",
      "description": "True when this lead_id was not present in the previous run's registry. Stamped by lead_registry.stamp_leads."
    },
    "first_seen_date": {
      "type": "string",
      "description": "ISO date string of when this lead first entered the system."
    }
  },
  "allOf": [
    {
      "description": "R3(iii) enrichment-optional rule — parcel_display is present iff enrichment_status is ENRICHED.",
      "if": { "properties": { "enrichment_status": { "const": "UNENRICHED" } } },
      "then": { "properties": { "parcel_display": { "type": "null" } } }
    },
    {
      "if": { "properties": { "enrichment_status": { "const": "ENRICHED" } } },
      "then": {
        "properties": { "parcel_display": { "type": "object" } },
        "required": ["parcel_display"]
      }
    }
  ]
}
